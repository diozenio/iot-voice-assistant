{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iot-voice-assistant",
  "version": "0.1.0",
  "identifier": "com.dionisiobarbosa.iot-voice-assistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IoT Voice Assistant - Dashboard",
        "width": 1040,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "visible": true,
        "focus": true,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
